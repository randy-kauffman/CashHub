{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps_1": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "sanic_CHCRDataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      },
      "shared_teams_1": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "sanic_chcrteams"
        },
        "api": {
          "name": "shared_teams"
        }
      },
      "shared_office365-1": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "sanic_CHCROutlook"
        },
        "api": {
          "name": "shared_office365"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "CH-EV-SharedMailboxAddress (sanic_CHEVSharedMailboxAddress)": {
          "defaultValue": "cashhub@55xljh.onmicrosoft.com",
          "type": "String",
          "metadata": {
            "schemaName": "sanic_CHEVSharedMailboxAddress"
          }
        },
        "CH-EV-OpsTeamsGroupId (sanic_CHEVOpsTeamsGroupId)": {
          "defaultValue": "19:db61af34d3524b8b8c572c649388fa74@thread.v2",
          "type": "String",
          "metadata": {
            "schemaName": "sanic_CHEVOpsTeamsGroupId",
            "description": "Group chat de Teams del equipo de operaciones para alertas del barrido de ingesta. Vacio = sin alertas de Teams (solo heartbeat)."
          }
        }
      },
      "triggers": {
        "Cada_10_minutos": {
          "recurrence": {
            "frequency": "Minute",
            "interval": 10
          },
          "metadata": {
            "operationMetadataId": "a0d740ad-2fe6-4ade-9815-b12b47022ee9"
          },
          "type": "Recurrence"
        }
      },
      "actions": {
        "Init_varSanados": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "edf48128-48e0-4bb3-9953-3efef77dd3ef"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "varSanados",
                "type": "integer",
                "value": 0
              }
            ]
          }
        },
        "Init_varFaltantes": {
          "runAfter": {
            "Init_varSanados": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "09f9935b-392d-4cd3-8ab0-89f9e31bcc2c"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "varFaltantes",
                "type": "integer",
                "value": 0
              }
            ]
          }
        },
        "Init_varAsuntos": {
          "runAfter": {
            "Init_varFaltantes": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "dae76442-bf36-44e4-ad2c-39c0e4be2cda"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "varAsuntosFaltantes",
                "type": "array",
                "value": []
              }
            ]
          }
        },
        "Init_varNotas": {
          "runAfter": {
            "Init_varAsuntos": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "8c0329db-cce5-402d-aff8-e34ec83af991"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "varNotas",
                "type": "array",
                "value": []
              }
            ]
          }
        },
        "Sanar_pendientes": {
          "actions": {
            "Buscar_pendientes_viejos": {
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "99260a9c-fe13-4754-a649-e780dedccfd2"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps_1",
                  "operationId": "ListRecords",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "sanic_chtblreceivedemailses",
                  "$select": "sanic_chtblreceivedemailsid,sanic_subject,modifiedon",
                  "$filter": "sanic_validationstatus eq 159460000 and sanic_emailreviewstatus eq 159460000",
                  "$top": 20
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "exponential",
                  "count": 4,
                  "interval": "PT10S"
                }
              }
            },
            "Por_cada_pendiente": {
              "foreach": "@outputs('Buscar_pendientes_viejos')?['body/value']",
              "actions": {
                "Tiene_run": {
                  "runAfter": {},
                  "metadata": {
                    "operationMetadataId": "d8bd6528-9bd9-4e6a-a945-0c490f31537e"
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps_1",
                      "operationId": "ListRecords",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "sanic_chtblvalidationrunses",
                      "$select": "sanic_chtblvalidationrunsid,modifiedon",
                      "$filter": "sanic_sourcerecordid eq '@{items('Por_cada_pendiente')?['sanic_chtblreceivedemailsid']}'",
                      "$orderby": "modifiedon desc",
                      "$top": 1
                    },
                    "authentication": "@parameters('$authentication')",
                    "retryPolicy": {
                      "type": "exponential",
                      "count": 4,
                      "interval": "PT10S"
                    }
                  }
                },
                "Sin_run": {
                  "actions": {
                    "Revalidar": {
                      "runAfter": {},
                      "metadata": {
                        "operationMetadataId": "3f3dae60-3eab-4ea9-9572-11a3270ebdef"
                      },
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_commondataserviceforapps_1",
                          "operationId": "PerformUnboundAction",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                        },
                        "parameters": {
                          "actionName": "sanic_CHValidateReceivedEmail",
                          "item/ReceivedEmailId": "@items('Por_cada_pendiente')?['sanic_chtblreceivedemailsid']"
                        },
                        "authentication": "@parameters('$authentication')"
                      }
                    },
                    "Contar_sanado": {
                      "runAfter": {
                        "Revalidar": [
                          "Succeeded"
                        ]
                      },
                      "metadata": {
                        "operationMetadataId": "da49d54a-6ae0-4668-b30a-1418d0b4b688"
                      },
                      "type": "IncrementVariable",
                      "inputs": {
                        "name": "varSanados",
                        "value": 1
                      }
                    }
                  },
                  "runAfter": {
                    "Tiene_run": [
                      "Succeeded"
                    ]
                  },
                  "expression": {
                    "or": [
                      {
                        "equals": [
                          "@length(outputs('Tiene_run')?['body/value'])",
                          0
                        ]
                      },
                      {
                        "less": [
                          "@coalesce(first(outputs('Tiene_run')?['body/value'])?['modifiedon'], '1900-01-01')",
                          "@items('Por_cada_pendiente')?['modifiedon']"
                        ]
                      }
                    ]
                  },
                  "metadata": {
                    "operationMetadataId": "758ac8be-3f0b-4eaf-891a-b15e7ecb1598"
                  },
                  "type": "If"
                }
              },
              "runAfter": {
                "Buscar_pendientes_viejos": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "b29258ba-b6d7-4375-b9a1-ec5a44b69c1b"
              },
              "type": "Foreach"
            }
          },
          "runAfter": {
            "Init_varNotas": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "e4e52ab8-1006-4ef6-b66f-b32680b631d6"
          },
          "type": "Scope"
        },
        "Nota_sanar_fallo": {
          "runAfter": {
            "Sanar_pendientes": [
              "Failed",
              "TimedOut"
            ]
          },
          "metadata": {
            "operationMetadataId": "202db9d8-8d9a-434c-a895-9f9c9aa655e3"
          },
          "type": "AppendToArrayVariable",
          "inputs": {
            "name": "varNotas",
            "value": "FALLO el saneo de pendientes (revisar historial del barrido)."
          }
        },
        "Nota_buzon_fallo": {
          "runAfter": {
            "Vigilar_buzon": [
              "Failed",
              "TimedOut"
            ]
          },
          "metadata": {
            "operationMetadataId": "e64e0057-5b1d-4fab-86e2-978abb1fff03"
          },
          "type": "AppendToArrayVariable",
          "inputs": {
            "name": "varNotas",
            "value": "FALLO la lectura del buzon compartido (¿conexion de Outlook caida?)."
          }
        },
        "Alertar_si_faltan": {
          "actions": {
            "Alertar_Teams": {
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "f37f8b9c-9236-4dee-a5e8-d95ea0b69cee"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_teams_1",
                  "operationId": "PostCardToConversation",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams"
                },
                "parameters": {
                  "poster": "Flow bot",
                  "location": "Group chat",
                  "body/recipient": "@parameters('CH-EV-OpsTeamsGroupId (sanic_CHEVOpsTeamsGroupId)')",
                  "body/messageBody": "{\"type\":\"AdaptiveCard\",\"$schema\":\"http://adaptivecards.io/schemas/adaptive-card.json\",\"version\":\"1.4\",\"body\":[{\"type\":\"TextBlock\",\"weight\":\"Bolder\",\"size\":\"Medium\",\"color\":\"Attention\",\"text\":\"⚠ Barrido de ingesta CashHub\"},{\"type\":\"TextBlock\",\"wrap\":true,\"text\":\"Incidencias detectadas: @{variables('varFaltantes')}. Detalle: @{join(variables('varAsuntosFaltantes'), ' | ')}\"}]}"
                },
                "authentication": "@parameters('$authentication')"
              }
            }
          },
          "runAfter": {
            "Vigilar_buzon": [
              "Succeeded",
              "Failed",
              "TimedOut",
              "Skipped"
            ],
            "Nota_buzon_fallo": [
              "Succeeded",
              "Skipped"
            ]
          },
          "expression": {
            "and": [
              {
                "greater": [
                  "@variables('varFaltantes')",
                  0
                ]
              },
              {
                "not": {
                  "equals": [
                    "@parameters('CH-EV-OpsTeamsGroupId (sanic_CHEVOpsTeamsGroupId)')",
                    ""
                  ]
                }
              }
            ]
          },
          "metadata": {
            "operationMetadataId": "ba330cba-91d0-4193-a6f6-904b66b6b8f5"
          },
          "type": "If"
        },
        "Buscar_heartbeat": {
          "runAfter": {
            "Alertar_si_faltan": [
              "Succeeded",
              "Failed",
              "Skipped"
            ]
          },
          "metadata": {
            "operationMetadataId": "c52f4f70-0033-438c-8828-9e2d28f93be3"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps_1",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "sanic_chtblsystemheartbeats",
              "$select": "sanic_chtblsystemheartbeatid",
              "$filter": "sanic_name eq 'ingesta-correos'",
              "$top": 1
            },
            "authentication": "@parameters('$authentication')",
            "retryPolicy": {
              "type": "exponential",
              "count": 4,
              "interval": "PT10S"
            }
          }
        },
        "Existe_heartbeat": {
          "actions": {
            "Actualizar_heartbeat": {
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "d04d49b2-dc1a-47a6-a824-acff7cf3eb66"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps_1",
                  "operationId": "UpdateOnlyRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "sanic_chtblsystemheartbeats",
                  "recordId": "@first(outputs('Buscar_heartbeat')?['body/value'])?['sanic_chtblsystemheartbeatid']",
                  "item/sanic_lastrunon": "@utcNow()",
                  "item/sanic_details": "@concat('sanados=', string(variables('varSanados')), ' faltantes=', string(variables('varFaltantes')), ' notas=', join(variables('varNotas'), ' | '))"
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "exponential",
                  "count": 4,
                  "interval": "PT10S"
                }
              }
            }
          },
          "runAfter": {
            "Buscar_heartbeat": [
              "Succeeded"
            ]
          },
          "else": {
            "actions": {
              "Crear_heartbeat": {
                "runAfter": {},
                "metadata": {
                  "operationMetadataId": "d598c981-0732-4cc4-87b3-d7f05dde630f"
                },
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "connectionName": "shared_commondataserviceforapps_1",
                    "operationId": "CreateRecord",
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                  },
                  "parameters": {
                    "entityName": "sanic_chtblsystemheartbeats",
                    "item/sanic_lastrunon": "@utcNow()",
                    "item/sanic_details": "@concat('sanados=', string(variables('varSanados')), ' faltantes=', string(variables('varFaltantes')), ' notas=', join(variables('varNotas'), ' | '))",
                    "item/sanic_name": "ingesta-correos"
                  },
                  "authentication": "@parameters('$authentication')",
                  "retryPolicy": {
                    "type": "exponential",
                    "count": 4,
                    "interval": "PT10S"
                  }
                }
              }
            }
          },
          "expression": {
            "greater": [
              "@length(outputs('Buscar_heartbeat')?['body/value'])",
              0
            ]
          },
          "metadata": {
            "operationMetadataId": "d991cbb3-4fa2-4be8-b270-6792327008eb"
          },
          "type": "If"
        },
        "Vigilar_flujo_de_ingesta": {
          "actions": {
            "Estado_del_flujo_de_ingesta": {
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "d8ac04a1-f8fe-4473-a24f-46f8b4191234"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps_1",
                  "operationId": "ListRecords",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "workflows",
                  "$select": "workflowid,statecode,statuscode",
                  "$filter": "category eq 5 and name eq 'CH-Flow-IngestEmails'",
                  "$top": 1
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "exponential",
                  "count": 4,
                  "interval": "PT10S"
                }
              }
            },
            "Ingesta_apagada": {
              "actions": {
                "Contar_ingesta_caida": {
                  "runAfter": {},
                  "metadata": {
                    "operationMetadataId": "6aa5d67d-f130-4aa3-bb78-2145d9db96bb"
                  },
                  "type": "IncrementVariable",
                  "inputs": {
                    "name": "varFaltantes",
                    "value": 1
                  }
                },
                "Nota_ingesta_caida": {
                  "runAfter": {
                    "Contar_ingesta_caida": [
                      "Succeeded"
                    ]
                  },
                  "metadata": {
                    "operationMetadataId": "d9984f48-301b-4624-aa9d-4140431d07dd"
                  },
                  "type": "AppendToArrayVariable",
                  "inputs": {
                    "name": "varAsuntosFaltantes",
                    "value": "CH-Flow-IngestEmails NO esta activo (apagado o suspendido): los correos se acumulan en el buzon sin procesar."
                  }
                }
              },
              "runAfter": {
                "Estado_del_flujo_de_ingesta": [
                  "Succeeded"
                ]
              },
              "expression": {
                "not": {
                  "equals": [
                    "@first(outputs('Estado_del_flujo_de_ingesta')?['body/value'])?['statecode']",
                    1
                  ]
                }
              },
              "metadata": {
                "operationMetadataId": "72b97bae-5ad6-4449-a93e-d83cbf730b5e"
              },
              "type": "If"
            }
          },
          "runAfter": {
            "Sanar_pendientes": [
              "Succeeded",
              "Failed",
              "TimedOut",
              "Skipped"
            ]
          },
          "metadata": {
            "operationMetadataId": "8ddb2ddd-284a-47e6-a595-ca594e8bb2fd"
          },
          "type": "Scope"
        },
        "Vigilar_buzon": {
          "actions": {
            "Leer_buzon": {
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "576953e2-88a0-4423-832b-17c156b2f630"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_office365-1",
                  "operationId": "GetEmailsV3",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "fetchOnlyUnread": false,
                  "mailboxAddress": "@parameters('CH-EV-SharedMailboxAddress (sanic_CHEVSharedMailboxAddress)')",
                  "includeAttachments": false,
                  "top": 25
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Por_cada_correo_buzon": {
              "foreach": "@outputs('Correos_del_buzon')",
              "actions": {
                "Es_viejo_sin_registrar": {
                  "actions": {
                    "Buscar_registro": {
                      "runAfter": {},
                      "metadata": {
                        "operationMetadataId": "06a01cc6-5696-4915-bacd-664a74334890"
                      },
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_commondataserviceforapps_1",
                          "operationId": "ListRecords",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                        },
                        "parameters": {
                          "entityName": "sanic_chtblreceivedemailses",
                          "$select": "sanic_chtblreceivedemailsid",
                          "$filter": "sanic_receivedemailinternetmessageid eq '@{items('Por_cada_correo_buzon')?['internetMessageId']}'",
                          "$top": 1
                        },
                        "authentication": "@parameters('$authentication')",
                        "retryPolicy": {
                          "type": "exponential",
                          "count": 4,
                          "interval": "PT10S"
                        }
                      }
                    },
                    "No_registrado": {
                      "actions": {
                        "Contar_faltante": {
                          "runAfter": {
                            "Rescatar_correo": [
                              "Succeeded",
                              "Failed",
                              "TimedOut"
                            ]
                          },
                          "metadata": {
                            "operationMetadataId": "b762987d-4f20-4dd7-b67a-3bd78d83d08a"
                          },
                          "type": "IncrementVariable",
                          "inputs": {
                            "name": "varFaltantes",
                            "value": 1
                          }
                        },
                        "Guardar_asunto": {
                          "runAfter": {
                            "Contar_faltante": [
                              "Succeeded"
                            ]
                          },
                          "metadata": {
                            "operationMetadataId": "596fb7eb-228e-4e1d-a1a0-dd0ef32ec8b1"
                          },
                          "type": "AppendToArrayVariable",
                          "inputs": {
                            "name": "varAsuntosFaltantes",
                            "value": "@concat('Rescatado por el barrido (el trigger no lo tomo): ', items('Por_cada_correo_buzon')?['subject'], ' | ', coalesce(outputs('Rescatar_correo')?['body/Resultado'], 'el rescate fallo; el correo queda en el Inbox y se reintenta en la proxima corrida'))"
                          }
                        },
                        "Rescatar_correo": {
                          "runAfter": {},
                          "metadata": {
                            "operationMetadataId": "7073d0a4-ac2f-4302-911f-84c589e26845"
                          },
                          "type": "Workflow",
                          "inputs": {
                            "host": {
                              "workflowReferenceName": "a1b2c3d4-5e6f-4a7b-8c9d-0e1f2a3b4c5d"
                            },
                            "body": {
                              "text": "@items('Por_cada_correo_buzon')?['id']"
                            }
                          }
                        }
                      },
                      "runAfter": {
                        "Buscar_registro": [
                          "Succeeded"
                        ]
                      },
                      "expression": {
                        "equals": [
                          "@length(outputs('Buscar_registro')?['body/value'])",
                          0
                        ]
                      },
                      "metadata": {
                        "operationMetadataId": "438c4792-7790-424b-b937-c52ce38d85a9"
                      },
                      "type": "If"
                    }
                  },
                  "runAfter": {},
                  "expression": {
                    "less": [
                      "@items('Por_cada_correo_buzon')?['receivedDateTime']",
                      "@addMinutes(utcNow(),-5)"
                    ]
                  },
                  "metadata": {
                    "operationMetadataId": "db20082b-badd-4d02-9da6-ff1df6608690"
                  },
                  "type": "If"
                }
              },
              "runAfter": {
                "Correos_del_buzon": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "23a731b4-beb7-4c4b-9bef-8b13b3c4c052"
              },
              "type": "Foreach"
            },
            "Leer_buzon_espanol": {
              "runAfter": {
                "Leer_buzon": [
                  "Failed"
                ]
              },
              "metadata": {
                "operationMetadataId": "bb651d20-381f-443e-be79-8f75aaf7dcb7"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_office365-1",
                  "operationId": "GetEmailsV3",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "folderPath": "Bandeja de entrada",
                  "fetchOnlyUnread": false,
                  "mailboxAddress": "@parameters('CH-EV-SharedMailboxAddress (sanic_CHEVSharedMailboxAddress)')",
                  "includeAttachments": false,
                  "top": 25
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Correos_del_buzon": {
              "runAfter": {
                "Leer_buzon_espanol": [
                  "Succeeded",
                  "Skipped"
                ]
              },
              "metadata": {
                "operationMetadataId": "05e558eb-321c-4176-a9ab-01616e17e400"
              },
              "type": "Compose",
