{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps_1": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "sanic_CHCRDataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "Cada_15_minutos": {
          "type": "Recurrence",
          "metadata": {
            "operationMetadataId": "2ae95cdc-672d-4668-aea8-7bf73b11fbfc"
          },
          "recurrence": {
            "frequency": "Minute",
            "interval": 15
          }
        }
      },
      "actions": {
        "Obtener_timeout_configurado": {
          "type": "OpenApiConnection",
          "metadata": {
            "operationMetadataId": "1a2fd850-302a-4d7b-98e0-a2150aeb2fb5"
          },
          "runAfter": {},
          "inputs": {
            "parameters": {
              "entityName": "environmentvariablevalues",
              "$filter": "schemaname eq 'sanic_CHEVRfcApplyTimeoutMinutes' ",
              "$top": 1
            },
            "host": {
              "connectionName": "shared_commondataserviceforapps_1",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "operationId": "ListRecords"
            },
            "retryPolicy": {
              "type": "exponential",
              "count": 4,
              "interval": "PT10S"
            }
          }
        },
        "Inicializar_varTimeoutMinutos": {
          "type": "InitializeVariable",
          "metadata": {
            "operationMetadataId": "df75d952-2004-4e59-aa5c-e2d37bbdddca"
          },
          "runAfter": {
            "Obtener_timeout_configurado": [
              "Succeeded",
              "Failed"
            ]
          },
          "inputs": {
            "variables": [
              {
                "name": "varTimeoutMinutos",
                "type": "integer",
                "value": "@int(coalesce(first(outputs('Obtener_timeout_configurado')?['body/value'])?['value'], '30'))"
              }
            ]
          }
        },
        "Buscar_RFCs_huerfanos": {
          "type": "OpenApiConnection",
          "metadata": {
            "operationMetadataId": "b1ec600d-e03b-4c87-bfb9-9a9001d5494a"
          },
          "runAfter": {
            "Inicializar_varTimeoutMinutos": [
              "Succeeded"
            ]
          },
          "inputs": {
            "parameters": {
              "entityName": "sanic_chtblclientdatachangerequests",
              "$select": "sanic_chtblclientdatachangerequestid,sanic_name",
              "$filter": "sanic_changestatus eq 159460002 and modifiedon lt @{addMinutes(utcNow(), mul(-1, variables('varTimeoutMinutos')))}"
            },
            "host": {
              "connectionName": "shared_commondataserviceforapps_1",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "operationId": "ListRecords"
            },
            "retryPolicy": {
              "type": "exponential",
              "count": 4,
              "interval": "PT10S"
            }
          }
        },
        "Por_cada_RFC_huerfano": {
          "type": "Foreach",
          "metadata": {
            "operationMetadataId": "c793644d-ebe1-426a-a355-6e5174426b08"
          },
          "runAfter": {
            "Buscar_RFCs_huerfanos": [
              "Succeeded"
            ]
          },
          "foreach": "@outputs('Buscar_RFCs_huerfanos')?['body/value']",
          "actions": {
            "Marcar_RFC_como_FAILED": {
              "type": "OpenApiConnection",
              "metadata": {
                "operationMetadataId": "6c71a14c-fb40-4596-920b-596338cab819"
              },
              "runAfter": {},
              "inputs": {
                "parameters": {
                  "entityName": "sanic_chtblclientdatachangerequests",
                  "recordId": "@items('Por_cada_RFC_huerfano')?['sanic_chtblclientdatachangerequestid']",
                  "item/sanic_changestatus": 159460005,
                  "item/sanic_applynotes": "@concat('Watchdog: el RFC quedo en Approved por mas de ', string(variables('varTimeoutMinutos')), ' minutos sin que el flujo de aplicacion lo procesara. Marcado como Failed automaticamente; revisar historial de ejecuciones de Power Automate y reenviar el cambio.')",
                  "item/sanic_applyon": "@convertFromUtc(utcNow(),'Central America Standard Time','yyyy-MM-dd HH:mm:ss')"
                },
                "host": {
                  "connectionName": "shared_commondataserviceforapps_1",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "operationId": "UpdateOnlyRecord"
                },
                "retryPolicy": {
                  "type": "exponential",
                  "count": 4,
                  "interval": "PT10S"
                }
              }
            },
            "Crear_audit_trail_watchdog": {
              "type": "OpenApiConnection",
              "metadata": {
                "operationMetadataId": "eee50d1e-efa8-47f4-9c61-63f163f61feb"
              },
              "runAfter": {
                "Marcar_RFC_como_FAILED": [
                  "Succeeded",
                  "Failed"
                ]
              },
              "inputs": {
                "parameters": {
                  "entityName": "sanic_chtblclientdatachangesaudittrails",
                  "item/sanic_opeationtype": 159460001,
                  "item/sanic_RelatedRFC@odata.bind": "/sanic_chtblclientdatachangerequests(@{items('Por_cada_RFC_huerfano')?['sanic_chtblclientdatachangerequestid']})",
                  "item/sanic_result": false,
                  "item/sanic_message": "WATCHDOG: RFC detectado en Approved sin aplicar tras el timeout configurado. Marcado Failed automaticamente."
                },
                "host": {
                  "connectionName": "shared_commondataserviceforapps_1",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "operationId": "CreateRecord"
                },
                "retryPolicy": {
                  "type": "exponential",
                  "count": 4,
                  "interval": "PT10S"
                }
              }
            }
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}