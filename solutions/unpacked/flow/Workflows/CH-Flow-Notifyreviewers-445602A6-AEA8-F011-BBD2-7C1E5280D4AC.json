{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps_1": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "sanic_CHCRDataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      },
      "shared_teams_1": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "sanic_chcrteams"
        },
        "api": {
          "name": "shared_teams"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "Cuando_un_nuevo_cambio_este_en_status_\"Submitted\"": {
          "metadata": {
            "operationMetadataId": "5edcecad-2c18-459e-95e4-96624397f817"
          },
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps_1",
              "operationId": "SubscribeWebhookTrigger",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "subscriptionRequest/message": 4,
              "subscriptionRequest/entityname": "sanic_chtblclientdatachangerequest",
              "subscriptionRequest/scope": 4,
              "subscriptionRequest/filterexpression": "sanic_changestatus eq 159460001"
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      },
      "actions": {
        "Obtener_lineas_del_RFC_(CRL)": {
          "runAfter": {
            "Obtener_mas_datos_del_RFC": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "6eff451b-955a-4abe-883a-b92d54978af5"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps_1",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "sanic_chtblclientdatachangerequestlines",
              "$filter": "_sanic_changerequestid_value eq @{triggerOutputs()?['body/sanic_chtblclientdatachangerequestid']}"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Inicializar_variable_varField": {
          "runAfter": {
            "Obtener_lineas_del_RFC_(CRL)": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "aeff1c1b-7fd9-46c0-9161-1a34477f8183"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "varField",
                "type": "array"
              }
            ]
          }
        },
        "Por_cada_CRL": {
          "foreach": "@outputs('Obtener_lineas_del_RFC_(CRL)')?['body/value']",
          "actions": {
            "Añadir_campo_que_se_cambiarai": {
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "7a9e5114-6a60-4f04-90ad-a2c8dbb66951"
              },
              "type": "AppendToArrayVariable",
              "inputs": {
                "name": "varField",
                "value": {
                  "type": "TextBlock",
                  "text": "@{items('Por_cada_CRL')?['_sanic_fielddefinition_value@OData.Community.Display.V1.FormattedValue']}",
                  "wrap": true
                }
              }
            },
            "Añadir_antiguo_valor": {
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "0114e909-6742-49f4-a290-bdde37fecca8"
              },
              "type": "AppendToArrayVariable",
              "inputs": {
                "name": "varNewValue",
                "value": {
                  "type": "TextBlock",
                  "text": "@{items('Por_cada_CRL')?['sanic_newvalue']}",
                  "wrap": true
                }
              }
            },
            "Añadir_nuevo_valor": {
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "7103aa72-485f-41fb-aba1-5850aa5601eb"
              },
              "type": "AppendToArrayVariable",
              "inputs": {
                "name": "varOldValue",
                "value": {
                  "type": "TextBlock",
                  "text": "@{items('Por_cada_CRL')?['sanic_oldvalue']}",
                  "wrap": true
                }
              }
            }
          },
          "runAfter": {
            "Inicializar_variable_varOldValue": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "791e671d-24bc-4c74-b78c-86229b2a7a88"
          },
          "type": "Foreach"
        },
        "inicializar_variable_varNewValue": {
          "runAfter": {
            "Inicializar_variable_varField": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "0d5d5841-83e7-46e1-946e-bd265b0c167a"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "varNewValue",
                "type": "array"
              }
            ]
          }
        },
        "Inicializar_variable_varOldValue": {
          "runAfter": {
            "inicializar_variable_varNewValue": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "9d7134ca-e6e5-47de-bd8f-4ee425d1aee4"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "varOldValue",
                "type": "array"
              }
            ]
          }
        },
        "Obtener_mas_datos_del_RFC": {
          "runAfter": {
            "Obtener_enlace_a_la_app_de_adminsitracion_de_clientes": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "6bda0f4d-abb0-4026-8a6b-71896d3da600"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps_1",
              "operationId": "GetItem",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "sanic_chtblclientdatachangerequests",
              "recordId": "@triggerOutputs()?['body/sanic_chtblclientdatachangerequestid']",
              "$expand": "createdby($select=fullname)"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Obtener_enlace_a_la_app_de_adminsitracion_de_clientes": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "68daec13-3e64-489d-b169-52093c2a1c35"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps_1",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "sanic_chtblparameters",
              "$select": "sanic_value",
              "$filter": "sanic_name eq 'Apps.ClientAdministration.Url' and sanic_isactive eq true",
              "$top": 1
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Construir_adaptive_card": {
          "runAfter": {
            "Por_cada_CRL": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "23d312a7-d49a-4f52-ae88-d3a02e6c98c3"
          },
          "type": "Compose",
          "inputs": {
            "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
            "type": "AdaptiveCard",
            "version": "1.5",
            "body": [
              {
                "type": "Badge",
                "text": "@{triggerOutputs()?['body/_sanic_type_label']}",
                "size": "ExtraLarge",
                "style": "@{if(equals(outputs('Obtener_mas_datos_del_RFC')?['body/sanic_type'],159460000), 'Warning',if(equals(outputs('Obtener_mas_datos_del_RFC')?['body/sanic_type'],159460001),'Attention','Good'))}"
              },
              {
                "type": "TextBlock",
                "text": "RFC Resumen de cambios",
                "weight": "bolder",
                "size": "ExtraLarge"
              },
              {
                "type": "FactSet",
                "facts": [
                  {
                    "title": "RFC ID",
                    "value": "@{triggerOutputs()?['body/sanic_name']}"
                  },
                  {
                    "title": "Fecha de creacion",
                    "value": "@{formatDateTime(triggerOutputs()?['body/createdon'],'yyyy-MM-dd HH:mm')}"
                  },
                  {
                    "title": "Creado por",
                    "value": "@{outputs('Obtener_mas_datos_del_RFC')?['body/createdby/fullname']}"
                  },
                  {
                    "title": "Motivo",
                    "value": "@{triggerOutputs()?['body/sanic_reason']}"
                  },
                  {
                    "title": "Cantidad de cambios",
                    "value": "@{length(outputs('Obtener_lineas_del_RFC_(CRL)')?['body/value'])}"
                  },
                  {
                    "title": "Tabla objetivo",
                    "value": "@{triggerOutputs()?['body/sanic_targettabledisplayname']}"
                  }
                ]
              },
              {
                "type": "TextBlock",
                "text": "Detalle de cambios",
                "weight": "Bolder",
                "spacing": "Medium"
              },
              {
                "type": "ColumnSet",
                "columns": [
                  {
                    "type": "Column",
                    "width": "stretch",
                    "items": [
                      {
                        "type": "TextBlock",
                        "text": "Campo",
                        "weight": "Bolder"
                      }
                    ]
                  },
                  {
                    "type": "Column",
                    "width": "stretch",
                    "items": [
                      {
                        "type": "TextBlock",
                        "text": "Valor actual",
                        "weight": "Bolder"
                      }
                    ]
                  },
                  {
                    "type": "Column",
                    "width": "stretch",
                    "items": [
                      {
                        "type": "TextBlock",
                        "text": "Nuevo valor",
                        "weight": "Bolder"
                      }
                    ]
                  }
                ]
              },
              {
                "$data": "${changes}",
                "type": "Container",
                "items": [
                  {
                    "type": "ColumnSet",
                    "columns": [
                      {
                        "type": "Column",
                        "width": "stretch",
                        "items": "@variables('varField')"
                      },
                      {
                        "type": "Column",
                        "width": "stretch",
                        "items": "@variables('varOldValue')"
                      },
                      {
                        "type": "Column",
                        "width": "stretch",
                        "items": "@variables('varNewValue')"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "ActionSet",
                "actions": [
                  {
                    "type": "Action.OpenUrl",
                    "title": "Abrir app",
                    "horizontalAlignment": "Center",
                    "style": "positive",
                    "tooltip": "Abrir app",
                    "url": "@{first(outputs('Obtener_enlace_a_la_app_de_adminsitracion_de_clientes')?['body/value'])?['sanic_value']}&RFC=@{triggerOutputs()?['body/sanic_chtblclientdatachangerequestid']}"
                  }
                ]
              }
            ]
          }
        },
        "List_rows": {
          "runAfter": {
            "Construir_adaptive_card": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "5a1fba30-0681-4819-907e-ddd675b6ea70"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps_1",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "sanic_chtblclientdatachangepermissions",
              "$filter": "sanic_name eq '@{triggerOutputs()?['body/sanic_targettable']}' and sanic_type eq 159460001"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "For_each": {
          "foreach": "@outputs('List_rows')?['body/value']",
          "actions": {
            "Condition": {
              "actions": {
                "Run_a_Child_Flow": {
                  "runAfter": {},
                  "metadata": {
                    "operationMetadataId": "c8cc6340-57fd-4ee0-a219-b848c310b022"
                  },
                  "type": "Workflow",
                  "inputs": {
                    "host": {
                      "workflowReferenceName": "f386eeb1-f2aa-f011-bbd2-000d3a52eba2"
                    },
                    "body": {
                      "text": "@items('For_each')?['sanic_aadgroupid']",
                      "text_1": "CashHub-Aprobadores de cambios en @{triggerOutputs()?['body/sanic_targettabledisplayname']}"
                    }
                  }
                },
                "Update_a_row": {
                  "runAfter": {
                    "Run_a_Child_Flow": [
                      "Succeeded"
                    ]
                  },
                  "metadata": {
                    "operationMetadataId": "93d0112c-1c39-46f7-86ea-2b5512441b4b"
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps_1",
                      "operationId": "UpdateOnlyRecord",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "sanic_chtblclientdatachangepermissions",
                      "recordId": "@items('For_each')?['sanic_chtblclientdatachangepermissionid']",
                      "item/sanic_teamsgroupid": "@body('Run_a_Child_Flow')?['chatid']"
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                },
                "Enviar_adaptive_card_a_aprobadores_1": {
                  "runAfter": {
                    "Update_a_row": [
                      "Succeeded"
                    ]
                  },
                  "metadata": {
                    "operationMetadataId": "e047dffd-adc5-4f77-9d04-68a8cb310229"
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_teams_1",
                      "operationId": "PostCardToConversation",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams"
                    },
                    "parameters": {
                      "poster": "Flow bot",
                      "location": "Group chat",
                      "body/recipient": "@body('Run_a_Child_Flow')?['chatid']",
                      "body/messageBody": "@outputs('Construir_adaptive_card')"
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                }
              },
              "runAfter": {},
              "else": {
                "actions": {
                  "Enviar_adaptive_card_a_aprobadores": {
                    "runAfter": {},
                    "metadata": {
                      "operationMetadataId": "808cf582-d680-4602-9e7e-8ef3c1522dc0"
                    },
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "connectionName": "shared_teams_1",
                        "operationId": "PostCardToConversation",
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams"
                      },
                      "parameters": {
                        "poster": "Flow bot",
                        "location": "Group chat",
                        "body/recipient": "@items('For_each')?['sanic_teamsgroupid']",
                        "body/messageBody": "@outputs('Construir_adaptive_card')"
                      },
                      "authentication": "@parameters('$authentication')"
                    }
                  }
                }
              },
              "expression": {
                "and": [
                  {
                    "equals": [
                      "@items('For_each')?['sanic_teamsgroupid']",
                      "@null"
                    ]
                  }
                ]
              },
              "metadata": {
                "operationMetadataId": "0ad9b324-6a3c-4a4b-b086-7e2bc456a4b0"
              },
              "type": "If"
            }
          },
          "runAfter": {
            "List_rows": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "ecb38ce2-6c31-4352-a0b7-64cda54f7e78"
          },
          "type": "Foreach"
        }
      }
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}