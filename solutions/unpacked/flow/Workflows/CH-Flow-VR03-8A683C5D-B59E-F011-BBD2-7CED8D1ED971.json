{
  "properties": {
    "connectionReferences": {},
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "manual": {
          "metadata": {
            "operationMetadataId": "5ac5cb82-bc1f-47ef-b84e-11dc28b745fc"
          },
          "type": "Request",
          "kind": "Button",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "text": {
                  "title": "EmailSubject",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "Please enter your input",
                  "x-ms-content-hint": "TEXT"
                },
                "text_1": {
                  "title": "ValidationValue",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "Please enter your input",
                  "x-ms-content-hint": "TEXT"
                }
              },
              "required": [
                "text",
                "text_1"
              ]
            }
          }
        }
      },
      "actions": {
        "Condition": {
          "actions": {
            "Respond_to_a_Power_App_or_flow": {
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "13c5c610-a273-417e-8fd7-2047ead27b62"
              },
              "type": "Response",
              "kind": "PowerApp",
              "inputs": {
                "statusCode": 200,
                "body": {
                  "validationresult": "Pass"
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "validationresult": {
                      "title": "ValidationResult",
                      "x-ms-dynamically-added": true,
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "runAfter": {},
          "else": {
            "actions": {
              "Respond_to_a_Power_App_or_flow_2": {
                "runAfter": {},
                "metadata": {
                  "operationMetadataId": "43a1c447-71c8-4577-bbaa-28344a738e39"
                },
                "type": "Response",
                "kind": "PowerApp",
                "inputs": {
                  "statusCode": 200,
                  "body": {
                    "validationresult": "Fail"
                  },
                  "schema": {
                    "type": "object",
                    "properties": {
                      "validationresult": {
                        "title": "ValidationResult",
                        "x-ms-dynamically-added": true,
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "expression": {
            "equals": [
              "@startsWith(toLower(triggerBody()['text']),toLower(triggerBody()['text_1']))",
              "@true"
            ]
          },
          "metadata": {
            "operationMetadataId": "eecdc829-6e44-4dbe-a39e-158865ea9c60"
          },
          "type": "If"
        },
        "Respond_to_a_Power_App_or_flow_3": {
          "runAfter": {
            "Condition": [
              "Failed",
              "Skipped",
              "TimedOut"
            ]
          },
          "metadata": {
            "operationMetadataId": "70e1b60a-9178-4fa6-986b-82556c364597"
          },
          "type": "Response",
          "kind": "PowerApp",
          "inputs": {
            "statusCode": 200,
            "body": {
              "validationresult": "Error"
            },
            "schema": {
              "type": "object",
              "properties": {
                "validationresult": {
                  "title": "ValidationResult",
                  "x-ms-dynamically-added": true,
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}