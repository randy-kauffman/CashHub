            "Agregar_una_fila_nueva": {
              "runAfter": {
                "Redactar": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "c67dbd89-3ff5-4318-9c00-aa6eee0386d5"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps_1",
