                },
                "parameters": {
                  "id": "@items('Aplicar_a_cada_uno')?['Id']",
                  "inferContentType": true
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Redactar": {
              "runAfter": {
                "Obtener_contenido_de_archivo": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "ebbcebec-dc37-449d-abdd-b56fc5d2f1d7"
              },
              "type": "Compose",
              "inputs": "@xml(outputs('Obtener_contenido_de_archivo')?['body'])"
