                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps_1",
                      "operationId": "CreateRecord",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "sanic_chtblxmlreadingdetails",
                      "item/sanic_currency": "@xpath(item(), 'string(/*/@Currency)')",
                      "item/sanic_XMLReading@odata.bind": "sanic_chtblxmlreadings(@{outputs('Agregar_una_fila_nueva')?['body/sanic_chtblxmlreadingid']})",
                      "item/sanic_denomination": "@float(xpath(item(), 'string(/*/@Value)'))",
                      "item/sanic_quantity": "@int(xpath(item(), 'string(/*/@Number)'))",
                      "item/sanic_name": " "
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                }
