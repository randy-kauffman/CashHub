                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "sanic_chtblxmlreadings",
                  "item/sanic_filename": "@items('Aplicar_a_cada_uno')?['Name']",
                  "item/sanic_RecountingSessionDetailId@odata.bind": "sanic_chtblrecountingsessiondetails(@{triggerBody()['text']})",
                  "item/sanic_isactive": true
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Aplicar_a_cada_uno_2": {
              "foreach": "@xpath(outputs('Redactar'), '//Counter')",
              "actions": {
                "Agregar_una_fila_nueva_2": {
                  "runAfter": {},
