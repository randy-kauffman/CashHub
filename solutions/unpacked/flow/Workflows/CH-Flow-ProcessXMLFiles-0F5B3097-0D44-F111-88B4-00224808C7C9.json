              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_onedriveforbusiness",
                  "operationId": "MoveFile",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_onedriveforbusiness"
                },
                "parameters": {
                  "id": "@item()?['Id']",
                  "destination": "/CashHub_XML_Anneke/Procesados/@{items('Aplicar_a_cada_uno')?['Name']}",
                  "overwrite": true
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Set_variable": {
              "runAfter": {
                "Agregar_una_fila_nueva": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "f9eb740e-3c92-4706-b851-8e52f9b981bc"
              },
              "type": "SetVariable",
              "inputs": {
                "name": "RecountingSessionID",
                "value": "@outputs('Agregar_una_fila_nueva')?['body/_sanic_recountingsessiondetailid_value@Microsoft.Dynamics.CRM.lookuplogicalname']"
              }
            }
          },
          "runAfter": {
            "Filter_array": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "4f6fc7f9-2a7b-4e7f-bd84-d6fc7ba4b739"
          },
          "type": "Foreach"
        },
        "Initialize_variable": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "fdda4f49-ded9-41e9-af20-b1e328bada71"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "RecountingSessionID",
