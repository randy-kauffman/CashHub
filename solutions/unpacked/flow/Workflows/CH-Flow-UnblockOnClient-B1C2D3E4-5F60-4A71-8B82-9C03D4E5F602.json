{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps-1": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "sanic_CHCRDataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "Cuando_Banca_toca_los_datos": {
          "metadata": {
            "operationMetadataId": "787c129c-0e01-4721-8565-9bcc8efa1771"
          },
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "parameters": {
              "subscriptionRequest/message": 4,
              "subscriptionRequest/entityname": "sanic_chtblclient",
              "subscriptionRequest/scope": 4
            },
            "host": {
              "connectionName": "shared_commondataserviceforapps-1",
              "operationId": "SubscribeWebhookTrigger",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      },
      "actions": {
        "Buscar_correos_bloqueados": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "ece71dde-2921-4a43-84e8-1a39c91e5935"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "entityName": "sanic_chtblreceivedemailses",
              "$select": "sanic_chtblreceivedemailsid,sanic_name",
              "$filter": "sanic_senderclassification eq 159460002 and (sanic_declaredcif eq '@{triggerOutputs()?['body/sanic_cifbco']}' or sanic_declaredcif eq '@{triggerOutputs()?['body/sanic_cifcom']}')",
              "$top": 50
            },
            "host": {
              "connectionName": "shared_commondataserviceforapps-1",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "retryPolicy": {
              "type": "exponential",
              "count": 4,
              "interval": "PT10S"
            }
          }
        },
        "Por_cada_bloqueado": {
          "foreach": "@outputs('Buscar_correos_bloqueados')?['body/value']",
          "actions": {
            "Reprocesar": {
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "3d614cbd-9a5d-4935-985a-67e9038cb050"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "entityName": "sanic_chtblreceivedemailses",
                  "recordId": "@items('Por_cada_bloqueado')?['sanic_chtblreceivedemailsid']",
                  "item/sanic_validationstatus": 159460000,
                  "item/sanic_emailreviewstatus": 159460000
                },
                "host": {
                  "connectionName": "shared_commondataserviceforapps-1",
                  "operationId": "UpdateOnlyRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "retryPolicy": {
                  "type": "exponential",
                  "count": 4,
                  "interval": "PT10S"
                }
              }
            }
          },
          "runAfter": {
            "Buscar_correos_bloqueados": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "52754459-5185-4892-b67d-3f62df051e6a"
          },
          "type": "Foreach"
        }
      }
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}