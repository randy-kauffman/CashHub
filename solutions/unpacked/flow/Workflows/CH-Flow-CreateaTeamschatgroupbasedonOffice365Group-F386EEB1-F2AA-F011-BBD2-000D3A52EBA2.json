          },
          "metadata": {
            "operationMetadataId": "1ff0ca5b-c8b5-4858-bfa0-7070aa2f2a15"
          },
          "type": "Select",
          "inputs": {
            "from": "@body('Filter_array')",
            "select": "@item()?['userPrincipalName']"
          }
        },
        "Get_my_profile_(V2)": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "5cc7b99d-5abe-481e-a44f-a2f11ed66823"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_office365users_1",
              "operationId": "MyProfile_V2",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365users"
            },
            "parameters": {},
            "authentication": {
              "type": "Raw",
              "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']"
            }
          }
        },
        "Filter_array": {
          "runAfter": {
            "List_group_members": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "6f38626f-c6d2-4c5c-a658-a5aaea341b3e"
          },
          "type": "Query",
          "inputs": {
            "from": "@outputs('List_group_members')?['body/value']",
            "where": "@not(equals(item()?['userPrincipalName'], outputs('Get_my_profile_(V2)')?['body/userPrincipalName']))"
          }
        }
      },
      "outputs": {}
    },
    "templateName": null
