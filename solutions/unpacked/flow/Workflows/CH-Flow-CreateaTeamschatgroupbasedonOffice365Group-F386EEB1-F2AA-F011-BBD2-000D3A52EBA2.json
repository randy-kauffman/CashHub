          },
          "metadata": {
            "operationMetadataId": "4f4d314b-73ac-47b8-bad1-5b779381983e"
          },
          "type": "Compose",
          "inputs": "@join(body('Select'),';')"
        },
        "Create_a_chat": {
          "runAfter": {
            "Compose": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "03f234d6-454e-405e-b2e4-47e09d910424"
          },
          "type": "OpenApiConnection",
          "inputs": {
