          "metadata": {
            "operationMetadataId": "d6d6d2f0-378a-4e2e-a763-7fb64568c549"
          },
          "type": "Response",
          "kind": "PowerApp",
          "inputs": {
            "statusCode": 200,
            "body": {
              "chatid": "@outputs('Create_a_chat')?['body/id']"
