      "actions": {
        "Listar_transacciones_del_lote": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "4c1a9d0e-77b2-4d5a-9f3c-2b8e6a1d5c40"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "entityName": "sanic_chtbltransactionses",
              "$select": "sanic_accountnumber,sanic_total,sanic_transactionid,sanic_transactionreference,sanic_currency,sanic_cashamount",
              "$filter": "_sanic_transactionbatch_value eq @{triggerBody()['text']}"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "connectionName": "shared_commondataserviceforapps_1"
            },
            "retryPolicy": {
              "type": "exponential",
              "count": 4,
              "interval": "PT10S"
            }
          },
          "runtimeConfiguration": {
            "paginationPolicy": {
              "minimumItemCount": 100000
            }
          }
        },
        "Select": {
          "runAfter": {
            "Listar_transacciones_del_lote": [
              "Succeeded"
            ],
            "Identidad": [
              "Succeeded"
            ]
          },
          "type": "Select",
          "inputs": {
            "from": "@outputs('Listar_transacciones_del_lote')?['body/value']",
            "select": {
              "TRNCODE": "@outputs('Identidad')?['TRNCODE']",
              "CUENTA": "@{formatNumber(coalesce(item()?['sanic_accountnumber'],0),'000000000')}",
              "MONTOTOTAL": "@{float(formatNumber(coalesce(item()?['sanic_total'],0),'0.00'))}",
              "REFERENCIA": "@{item()?['sanic_transactionid']}",
              "DEPOSITANTE": "@{coalesce(item()?['sanic_transactionreference'], item()?['sanic_transactionid'])}",
              "MONEDA": "@{if(equals(item()?['sanic_currency'],159460000),'COR',if(equals(item()?['sanic_currency'],159460001),'USD',if(equals(item()?['sanic_currency'],159460002),'EUR','')))}",
              "DEPOSITID": "@{item()?['sanic_transactionid']}",
              "DISPONIBILIDADINMEDIATA": "@{outputs('Identidad')?['DISPONIBILIDADINMEDIATA']}",
              "EFECTIVO": "@{float(formatNumber(coalesce(item()?['sanic_cashamount'],0),'0.00'))}",
              "MANIFIESTO": "@outputs('Identidad')?['MANIFIESTO']",
              "TIPOID": "@{outputs('Identidad')?['TIPOID']}",
              "NACIONALIDAD": "@{outputs('Identidad')?['NACIONALIDAD']}",
              "NUMEROID1": "@{outputs('Identidad')?['NUMEROID1']}",
              "NUMEROID2": "@{outputs('Identidad')?['NUMEROID2']}"
            }
          }
        },
        "Create_CSV_table": {
          "runAfter": {
            "Select": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "1762de77-ac8c-4002-8f68-a24ac4eacefb"
          },
          "type": "Table",
          "inputs": {
            "from": "@body('Select')",
            "format": "CSV"
          }
        },
        "Create_file": {
          "runAfter": {
            "Create_CSV_table": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "46664ef1-c668-479d-bd14-5ce7ab600f59"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "folderPath": "/tesoreria/",
              "name": "@{triggerBody()['text_1']}_@{convertFromUtc(utcNow(),'Central America Standard Time','yyyy-MM-dd_HHmm')}.csv",
              "body": "@body('Create_CSV_table')"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_onedriveforbusiness",
              "operationId": "CreateFile",
              "connectionName": "shared_onedriveforbusiness"
            }
          },
          "runtimeConfiguration": {
            "contentTransfer": {
              "transferMode": "Chunked"
            }
          }
        },
        "Create_share_link": {
          "runAfter": {
            "Create_file": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "00f09fea-2a1f-4c66-b9f4-0f80a4279c2b"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "id": "@outputs('Create_file')?['body/Id']",
              "type": "View",
              "scope": "Organization"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_onedriveforbusiness",
              "operationId": "CreateShareLinkV2",
              "connectionName": "shared_onedriveforbusiness"
            }
          }
        },
        "Respond_to_a_Power_App_or_flow": {
          "runAfter": {
            "Create_share_link": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "4b13f95f-5e4e-493f-ad9b-52832bd6a03d"
          },
          "type": "Response",
          "kind": "PowerApp",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "archivosalida": {
                  "title": "ArchivoSalida",
                  "x-ms-dynamically-added": true,
                  "type": "string"
                }
              },
              "additionalProperties": {}
            },
            "statusCode": 200,
            "body": {
              "archivosalida": "@{\r\nconcat(\r\n  outputs('Create_share_link')?['body/WebUrl'],\r\n  if(\r\n    equals(indexOf(outputs('Create_share_link')?['body/WebUrl'],'?'), -1),\r\n    '?download=1',\r\n    '&download=1'\r\n  )\r\n)\r\n}"
            }
          }
        },
        "Obtener_identidad": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
