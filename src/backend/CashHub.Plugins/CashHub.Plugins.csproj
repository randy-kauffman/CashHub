<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <LangVersion>latest</LangVersion>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>CashHub.snk</AssemblyOriginatorKeyFile>
    <RootNamespace>CashHub.Plugins</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.56" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <!-- El dominio se compila DENTRO del assembly del plugin: una sola dll firmada
       para el registro clásico de Dataverse. Los tests usan el proyecto aparte. -->
  <ItemGroup>
    <Compile Include="../CashHub.Validation/**/*.cs"
             Exclude="../CashHub.Validation/bin/**;../CashHub.Validation/obj/**"
             LinkBase="Validation" />
  </ItemGroup>
</Project>
